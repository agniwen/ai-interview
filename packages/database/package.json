  "dependencies": {
    "@app/db-schema": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.11.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
