{
  "name": "@app/database",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Drizzle database factory, Database type, package-scoped database context, and query helpers used by server, worker, and reusable packages",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./connection-options": "./src/connection-options.ts",
    "./context": "./src/context.ts",
    "./list-text-filters": "./src/list-text-filters.ts",
    "./pagination": "./src/pagination.ts",
    "./serialize": "./src/serialize.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@app/db-schema": "workspace:*",
    "@app/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.11.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
