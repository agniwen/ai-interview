{
  "name": "@app/database",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Drizzle database factory and database type used by server, worker, and reusable processing packages",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./recruiting-read-model": "./src/recruiting-read-model.ts",
    "./recruiting-records": "./src/recruiting-records.ts",
    "./recruiting-pipeline": "./src/recruiting-pipeline.ts",
    "./recruiting-ai-review": "./src/recruiting-ai-review.ts",
