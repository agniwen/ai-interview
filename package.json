{
  "name": "ai-tool-demo",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "hooks": "lefthook install",
    "db:generate": "pnpm --filter ai-recruitment-copilot db:generate",
    "db:migrate": "pnpm --filter ai-recruitment-copilot db:migrate",
    "db:studio": "pnpm --filter ai-recruitment-copilot db:studio"
  },
  "devDependencies": {
    "lefthook": "^2.1.6",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.63.0",
    "turbo": "^2.5.0",
    "ultracite": "7.6.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas"
    ]
  }
}
