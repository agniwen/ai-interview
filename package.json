{
  "name": "ai-recruitment-copilot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "pnpm --filter @arc/ai-recruitment-copilot-desktop dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:verbose": "VITEST_VERBOSE=1 turbo run test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "hooks": "lefthook install",
    "mastra:studio": "pnpm --filter @arc/ai-recruitment-copilot-backend studio:dev",
    "backfill:interview-snapshots": "pnpm --filter @arc/ai-recruitment-copilot-backend backfill:interview-snapshots",
    "backfill:resume-pool-semantic-index": "pnpm --filter @arc/ai-recruitment-copilot-backend backfill:resume-pool-semantic-index",
    "backfill:resume-semantic-index": "pnpm --filter @arc/ai-recruitment-copilot-backend backfill:resume-semantic-index",
    "benchmark:resume-parse": "pnpm --filter @arc/ai-recruitment-copilot-backend benchmark:resume-parse",
    "db:generate": "pnpm --filter @arc/ai-recruitment-copilot db:generate",
    "db:migrate": "pnpm --filter @arc/ai-recruitment-copilot db:migrate",
    "db:studio": "pnpm --filter @arc/ai-recruitment-copilot db:studio",
    "skills:update": "npx skills update -y"
  },
  "devDependencies": {
    "lefthook": "^2.1.6",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.63.0",
    "turbo": "^2.5.0",
    "typescript": "catalog:",
    "ultracite": "7.6.0"
  },
  "packageManager": "pnpm@11.5.2",
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/virtual-file-routes"
    ]
  }
}
