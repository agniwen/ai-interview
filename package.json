{
  "name": "ai-recruitment-copilot",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "ai": "^6.0.219",
      "chat": "^4.28.1",
      "drizzle-kit": "1.0.0-rc.1",
      "drizzle-orm": "1.0.0-rc.1",
      "next": "16.1.6",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "typescript": "7.0.2",
      "vite": "^8.1.3",
      "vitest": "4.1.7",
      "zod": "^4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "bun run --filter @arc/ai-recruitment-copilot-desktop dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "TZ=UTC turbo run test",
    "test:verbose": "TZ=UTC VITEST_VERBOSE=1 turbo run test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "hooks": "lefthook install",
    "backfill:interview-snapshots": "bun run --filter @arc/ai-recruitment-copilot-backend backfill:interview-snapshots",
    "backfill:resume-pool-semantic-index": "bun run --filter @arc/ai-recruitment-copilot-backend backfill:resume-pool-semantic-index",
    "backfill:resume-semantic-index": "bun run --filter @arc/ai-recruitment-copilot-backend backfill:resume-semantic-index",
    "benchmark:resume-parse": "bun run --filter @arc/ai-recruitment-copilot-backend benchmark:resume-parse",
    "db:generate": "bun run --filter @arc/ai-recruitment-copilot db:generate",
    "db:migrate": "bun run --filter @arc/ai-recruitment-copilot db:migrate",
    "db:studio": "bun run --filter @arc/ai-recruitment-copilot db:studio",
    "skills:update": "bunx skills update -y"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.79.0",
    "turbo": "^2.10.11",
    "typescript": "catalog:",
    "ultracite": "7.6.0"
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "packageManager": "bun@1.4.0",
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/virtual-file-routes"
    ]
  },
  "patchedDependencies": {
    "@larksuiteoapi/node-sdk@1.63.1": "patches/@larksuiteoapi__node-sdk@1.63.1.patch",
    "vitest@4.1.7": "patches/vitest@4.1.7.patch"
  },
  "trustedDependencies": [
    "cbor-extract",
    "electron",
    "electron-winstaller",
    "esbuild",
    "lefthook",
    "protobufjs",
    "sharp"
  ]
}
