    "@arc/resume-parse-queue": "workspace:*",
    "@arc/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@chat-adapter/state-pg": "^4.28.1",
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.7.6",
    "@livekit/protocol": "^1.45.8",
    "@qdrant/js-client-rest": "^1.18.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "ai": "catalog:",
    "better-auth": "^1.6.10",
    "chat": "catalog:",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "fast-xml-parser": "^5.8.0",
    "hono": "^4.12.18",
    "html-to-text": "9.0.5",
    "imapflow": "^1.4.1",
    "jszip": "^3.10.1",
    "livekit-server-sdk": "^2.15.2",
    "lodash-es": "^4.18.1",
    "mammoth": "^1.12.0",
    "mupdf": "^1.27.0",
    "nanoid": "^5.1.11",
    "openai": "^6.37.0",
    "p-limit": "7.3.0",
    "p-retry": "7.1.1",
    "postgres": "^3.4.9",
    "react": "catalog:",
    "resend": "^6.12.3",
    "tsx": "^4.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "24.11.2",
    "@types/react": "catalog:",
