{
  "name": "@arc/ai-recruitment-copilot-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Hono backend runtime for ARC",
  "type": "module",
  "exports": {
    "./server/routes/feishu/utils/interview-summary-card": "./src/server/routes/feishu/utils/interview-summary-card.tsx",
    "./server/routes/studio/routes/interviews/routes/round-emails/utils/templates": "./src/server/routes/studio/routes/interviews/routes/round-emails/utils/templates.tsx",
    "./server/*": "./src/server/*.ts",
    "./lib/server/db": "./src/lib/server/db/index.ts",
    "./lib/server/db/*": "./src/lib/server/db/*.ts",
    "./lib/server/*": "./src/lib/server/*.ts"
  },
  "scripts": {
    "backfill:resume-profiles": "tsx src/scripts/backfill-resume-profiles.ts",
    "backfill:resume-semantic-index": "tsx src/scripts/backfill-resume-semantic-index.ts",
    "dev:standalone": "tsx watch src/index.ts",
    "repair:default-recruiting-groups": "tsx src/scripts/repair-default-recruiting-groups.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
