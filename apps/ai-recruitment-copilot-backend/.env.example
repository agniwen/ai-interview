# =====================================================================
# Standalone Hono server
# =====================================================================

# Optional. Defaults to 0.0.0.0:8787 when unset.
HOST=
PORT=

# =====================================================================
# Worker server
# =====================================================================

# Optional. Defaults to 0.0.0.0:8790 when unset.
WORKER_HOST=
WORKER_PORT=

# =====================================================================
# Database / Auth
# =====================================================================

DATABASE_URL=
POSTGRES_POOL_MAX=
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_IDLE_TIMEOUT_SECONDS=60
POSTGRES_MAX_LIFETIME_SECONDS=1200

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_BASE_URL=

# Optional extra trusted origins (comma-separated). Built-in defaults already cover
# local web + desktop (localhost:3000 / 5173 / 5174). Unset is fine for most setups.
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =====================================================================
# LLM / OCR
# =====================================================================

ALIBABA_API_KEY=
ALIBABA_BASE_URL=
ALIBABA_MODEL=
ALIBABA_FAST_MODEL=
ALIBABA_STRUCTURED_MODEL=

# Resume semantic dedup / recommendation index
# Uses DashScope OpenAI-compatible embeddings and Qdrant vector search.
RESUME_SEMANTIC_INDEX_ENABLED=false
RESUME_EMBEDDING_MODEL=text-embedding-v4
RESUME_EMBEDDING_DIMENSIONS=1024
RESUME_EMBEDDING_VERSION=dashscope-text-embedding-v4-1024-v1
RESUME_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Defaults to ALIBABA_API_KEY when unset.
RESUME_EMBEDDING_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_RESUME_COLLECTION=resume_semantic_v1

QWEN_OCR_BASE_URL=
QWEN_OCR_MODEL=

# Resume parser implementation. Defaults to ocr-llm when unset.
# ocr-llm: local format extraction/Qwen OCR, then structured LLM extraction.
# aliyun-docmining: upload the original file to Tongyi Document Mining and
# extract the structured profile in one request.
RESUME_PARSE_PROVIDER=ocr-llm

# Read implicitly by AI SDK gateway() for interview evaluation.
AI_GATEWAY_API_KEY=
INTERVIEW_EVALUATION_MODEL=

# =====================================================================
# LiveKit / Agent callbacks
# =====================================================================

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional server-only Prometheus scrape endpoint for Platform > LiveKit metrics.
# Example: http://livekit-host.internal:6789/metrics
LIVEKIT_PROMETHEUS_URL=
AGENT_NAME=giaogiao
AGENT_CALLBACK_SECRET=

# AI interview recording feature flag. Defaults to true when unset.
NEXT_PUBLIC_ENABLE_INTERVIEW_RECORDING=true

# AI interview candidate-specific question generation. Defaults to true when unset.
NEXT_PUBLIC_ENABLE_CANDIDATE_SPECIFIC_INTERVIEW_QUESTIONS=true

# =====================================================================
# Object storage
# =====================================================================

S3_ENDPOINT=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=
S3_FORCE_PATH_STYLE=

# =====================================================================
# Redis / resume parse queue
# =====================================================================

# Redis connection string. For password-only Redis, use redis://:password@host:6379/0
REDIS_URL=

# Queue retry attempts and exponential-backoff base delay for bulk resume parsing.
RESUME_PARSE_QUEUE_ATTEMPTS=3
RESUME_PARSE_QUEUE_BACKOFF_MS=30000

# Worker-side concurrent resume parse jobs.
RESUME_PARSE_WORKER_CONCURRENCY=9

# Worker-side mixed Meeting Recording jobs. Docker installs ffmpeg.
# Override only when producer and worker intentionally share a deployment namespace.
# MEETING_PLAYBACK_QUEUE_PREFIX=
MEETING_PLAYBACK_WORKER_CONCURRENCY=2
# Final Meeting Transcript provider policy and queue producer.
# MEETING_TRANSCRIPTION_QUEUE_PREFIX=
MEETING_TRANSCRIPTION_OPENAI_ENABLED=false
MEETING_TRANSCRIPTION_OPENAI_MODEL=gpt-4o-transcribe-diarize
MEETING_TRANSCRIPTION_OPENAI_REGION=openai-default
FFMPEG_BIN=ffmpeg

# Processing items older than this are treated as interrupted on worker startup.
RESUME_PARSE_STALE_PROCESSING_SECONDS=900

# Per-PDF OCR page concurrency and transient connection retry settings.
RESUME_PARSE_OCR_PAGE_CONCURRENCY=4
RESUME_PARSE_OCR_ATTEMPTS=3
RESUME_PARSE_OCR_RETRY_DELAY_MS=1000

# Set to true when benchmarking the real parse path: bypasses same-hash parsed cache.
RESUME_PARSE_DISABLE_CACHE=false

RECORDING_R2_ENDPOINT=
RECORDING_R2_BUCKET_NAME=
RECORDING_R2_REGION=auto
RECORDING_R2_ACCESS_KEY_ID=
RECORDING_R2_SECRET_ACCESS_KEY=
RECORDING_R2_KEY_PREFIX=
RECORDING_R2_FORCE_PATH_STYLE=true

# =====================================================================
# Feishu
# =====================================================================

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_EVALUATION_FOLDER_TOKEN=
FEISHU_APP_ID2=
FEISHU_APP_SECRET2=
FEISHU_JIGUANG_HR_EVALUATION_FOLDER_TOKEN=
FEISHU_BOT_ENABLED=false

# =====================================================================
# Voice preview / Transactional email
# =====================================================================

MINIMAX_API_KEY=
MINIMAX_TTS_BASE_URL=

RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com
