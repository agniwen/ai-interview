# =====================================================================
# Standalone Hono server
# =====================================================================

# Optional. Defaults to 0.0.0.0:8787 when unset.
HOST=
PORT=

# =====================================================================
# Worker server
# =====================================================================

# Optional. Defaults to 0.0.0.0:8790 when unset.
WORKER_HOST=
WORKER_PORT=

# =====================================================================
# Database / Auth
# =====================================================================

DATABASE_URL=
POSTGRES_POOL_MAX=
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_IDLE_TIMEOUT_SECONDS=60
POSTGRES_MAX_LIFETIME_SECONDS=1200

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_BASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =====================================================================
# LLM / OCR
# =====================================================================

ALIBABA_API_KEY=
ALIBABA_BASE_URL=
ALIBABA_MODEL=
ALIBABA_FAST_MODEL=
ALIBABA_STRUCTURED_MODEL=

QWEN_OCR_BASE_URL=
QWEN_OCR_MODEL=

# Read implicitly by AI SDK gateway() for interview evaluation.
AI_GATEWAY_API_KEY=
INTERVIEW_EVALUATION_MODEL=

# =====================================================================
# LiveKit / Agent callbacks
# =====================================================================

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=
AGENT_CALLBACK_SECRET=

# =====================================================================
# Object storage
# =====================================================================

S3_ENDPOINT=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=
S3_FORCE_PATH_STYLE=

# =====================================================================
# Redis / resume parse queue
# =====================================================================

# Redis connection string. For password-only Redis, use redis://:password@host:6379/0
REDIS_URL=

# Queue retry attempts and exponential-backoff base delay for bulk resume parsing.
RESUME_PARSE_QUEUE_ATTEMPTS=3
RESUME_PARSE_QUEUE_BACKOFF_MS=30000

# Worker-side concurrent resume parse jobs.
RESUME_PARSE_WORKER_CONCURRENCY=3

# Processing items older than this are treated as interrupted on worker startup.
RESUME_PARSE_STALE_PROCESSING_SECONDS=900

# Per-PDF OCR page concurrency and transient connection retry settings.
RESUME_PARSE_OCR_PAGE_CONCURRENCY=1
RESUME_PARSE_OCR_ATTEMPTS=3
RESUME_PARSE_OCR_RETRY_DELAY_MS=1000

# Set to true when benchmarking the real parse path: bypasses same-hash parsed cache.
RESUME_PARSE_DISABLE_CACHE=false

RECORDING_R2_ENDPOINT=
RECORDING_R2_BUCKET_NAME=
RECORDING_R2_REGION=auto
RECORDING_R2_ACCESS_KEY_ID=
RECORDING_R2_SECRET_ACCESS_KEY=
RECORDING_R2_KEY_PREFIX=
RECORDING_R2_FORCE_PATH_STYLE=true

# =====================================================================
# Feishu
# =====================================================================

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_ID2=
FEISHU_APP_SECRET2=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY2=
FEISHU_VERIFICATION_TOKEN2=

# =====================================================================
# Voice preview / Transactional email
# =====================================================================

MINIMAX_API_KEY=
MINIMAX_TTS_BASE_URL=

RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com
