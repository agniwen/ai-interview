{
  "name": "@app/server",
  "version": "0.0.0",
  "private": true,
  "description": "Hono API runtime that owns authentication, workspace-scoped recruiting routes, persistence orchestration, and RPC contracts",
  "type": "module",
  "exports": {
    "./rpc-client": {
      "types": "./dist/rpc-client.d.ts",
      "default": "./src/rpc-client.ts"
    },
    "./web/runtime": "./src/exports/web/runtime.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.rpc-client.json",
    "dev:standalone": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@app/ai-runtime": "workspace:*",
    "@app/database": "workspace:*",
    "@app/db-schema": "workspace:*",
    "@app/feishu": "workspace:*",
    "@app/job-queues": "workspace:*",
    "@app/meeting-live-transcript": "workspace:*",
    "@app/meeting-media": "workspace:*",
    "@app/meeting-processing": "workspace:*",
    "@app/object-storage": "workspace:*",
    "@app/recruiting": "workspace:*",
    "@app/recruiting-workflows": "workspace:*",
    "@app/resume-processing": "workspace:*",
    "@app/shared": "workspace:*",
    "@better-auth/mcp": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.7.6",
    "@livekit/protocol": "^1.45.8",
    "@mastra/ai-sdk": "^1.10.7",
    "@mastra/core": "^1.75.0",
    "@mastra/observability": "^1.18.4",
    "@mastra/pg": "^1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "@sentry/hono": "10.76.2",
    "@t3-oss/env-core": "^0.13.11",
    "ai": "catalog:",
    "better-auth": "^1.7.2",
    "chat": "catalog:",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "hono": "^4.12.18",
    "imapflow": "^1.4.1",
    "jszip": "^3.10.1",
    "livekit-server-sdk": "^2.15.2",
    "lodash-es": "^4.18.1",
    "mupdf": "^1.27.0",
    "nanoid": "^5.1.11",
    "p-limit": "7.3.1",
    "p-retry": "7.1.1",
    "postgres": "^3.4.9",
    "react": "catalog:",
    "write-file-atomic": "^7.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "24.11.2",
    "@types/react": "catalog:",
    "@types/write-file-atomic": "^4.0.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
