{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "paths": {
      "@app/server/lib/server/*": ["./src/lib/server/*"],
      "@app/server/server/*": ["./src/server/*"]
    },
    "rootDir": "./src",
    "types": ["node"],
    "noEmit": true,
    "strictNullChecks": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
