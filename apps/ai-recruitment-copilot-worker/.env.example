# =====================================================================
# Worker server
# =====================================================================

# Optional. Defaults to 0.0.0.0:8790 when unset.
WORKER_HOST=
WORKER_PORT=

# Required to access /queues/* diagnostic endpoints. Health endpoints stay public.
WORKER_DIAGNOSTICS_SECRET=

# =====================================================================
# Database
# =====================================================================

DATABASE_URL=
POSTGRES_POOL_MAX=
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_IDLE_TIMEOUT_SECONDS=60
POSTGRES_MAX_LIFETIME_SECONDS=1200

# =====================================================================
# Redis / resume parse queue
# =====================================================================

# Redis connection string. For password-only Redis, use redis://:password@host:6379/0
REDIS_URL=

# Meeting processing workers. Prefixes are derived from DATABASE_URL unless explicitly set.
# MEETING_PLAYBACK_QUEUE_PREFIX=
MEETING_PLAYBACK_WORKER_CONCURRENCY=2
MEETING_DIRECT_UPLOAD_CONCURRENCY=100
MEETING_LIVE_TRANSCRIPT_CONCURRENCY=100
# MEETING_PURGE_QUEUE_PREFIX=
MEETING_PURGE_CONCURRENCY=2
# MEETING_INTELLIGENCE_QUEUE_PREFIX=
MEETING_INTELLIGENCE_CONCURRENCY=4
MEETING_ANSWER_CONCURRENCY=4
# MEETING_ANSWER_QUEUE_PREFIX=
MEETING_INTELLIGENCE_MAX_TRANSCRIPT_CHARS=120000
MEETING_INTELLIGENCE_MAX_REDUCE_CHARS=100000
# MEETING_TRANSCRIPTION_QUEUE_PREFIX=
MEETING_TRANSCRIPTION_CONCURRENCY=20
MEETING_TRANSCRIPTION_MEDIA_CONCURRENCY=2
MEETING_TRANSCRIPTION_FFMPEG_TIMEOUT_MS=1800000
# Alibaba Bailian (DashScope) non-real-time ASR — qwen3-asr-flash-filetrans / paraformer-v2.
# Reuses ALIBABA_API_KEY/ALIBABA_BASE_URL (LLM base path is stripped to the origin).
MEETING_TRANSCRIPTION_QWEN_ENABLED=false
MEETING_TRANSCRIPTION_QWEN_MODEL=qwen3-asr-flash-filetrans
# MEETING_TRANSCRIPTION_QWEN_BASE_URL=https://dashscope.aliyuncs.com
# Staged chunk URL expiry handed to DashScope for download.
MEETING_TRANSCRIPTION_QWEN_URL_EXPIRES_SECONDS=3600
# The Qwen adapter stages chunks in Recording R2 — set RECORDING_R2_* like the web app.
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com
FFMPEG_BIN=ffmpeg

# Queue total attempts (2 = initial parse + one retry) and exponential-backoff base delay.
RESUME_PARSE_QUEUE_ATTEMPTS=2
RESUME_PARSE_QUEUE_BACKOFF_MS=30000
RESUME_REVIEW_GENERATION_QUEUE_ATTEMPTS=2

# Worker-side concurrent resume parse jobs.
RESUME_PARSE_WORKER_CONCURRENCY=9
RESUME_REVIEW_GENERATION_WORKER_CONCURRENCY=12

# Processing items older than this are treated as interrupted on worker startup.
RESUME_PARSE_STALE_PROCESSING_SECONDS=900

# Per-PDF OCR page concurrency and transient connection retry settings.
RESUME_PARSE_OCR_PAGE_CONCURRENCY=4
RESUME_PARSE_OCR_ATTEMPTS=3
RESUME_PARSE_OCR_RETRY_DELAY_MS=1000

# Set to true when benchmarking the real parse path: bypasses same-hash parsed cache.
RESUME_PARSE_DISABLE_CACHE=false

# Set to true to log OCR and structured extraction sub-steps.
RESUME_PARSE_LOG_STEPS=false

# =====================================================================
# Mail ingest
# =====================================================================

# Poll configured user mailboxes for resume emails. Disabled by default.
MAIL_INGEST_ENABLED=false

# AES-GCM secret used to encrypt/decrypt mailbox client passwords stored in DB.
MAIL_INGEST_SECRET_KEY=

# Defaults to 15 minutes.
MAIL_INGEST_INTERVAL_MS=900000
MAIL_INGEST_MAX_ACCOUNTS_PER_RUN=20
MAIL_INGEST_MAX_MESSAGES_PER_ACCOUNT=20

# =====================================================================
# LLM / OCR
# =====================================================================

ALIBABA_API_KEY=
ALIBABA_BASE_URL=
ALIBABA_MODEL=deepseek-v4-flash-0731
ALIBABA_FAST_MODEL=deepseek-v4-flash-0731
ALIBABA_STRUCTURED_MODEL=deepseek-v4-flash-0731

# Resume semantic dedup / recommendation index
RESUME_SEMANTIC_INDEX_ENABLED=false
RESUME_EMBEDDING_MODEL=text-embedding-v4
RESUME_EMBEDDING_DIMENSIONS=1024
RESUME_EMBEDDING_VERSION=dashscope-text-embedding-v4-1024-v1
RESUME_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Defaults to ALIBABA_API_KEY when unset.
RESUME_EMBEDDING_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_RESUME_COLLECTION=resume_semantic_v1
RESUME_SEMANTIC_INDEX_WORKER_CONCURRENCY=9

QWEN_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_OCR_MODEL=qwen-vl-ocr-latest

# Resume parser implementation. Defaults to ocr-llm when unset.
# Supported values: ocr-llm, aliyun-docmining.
RESUME_PARSE_PROVIDER=ocr-llm

# =====================================================================
# Object storage
# =====================================================================

S3_ENDPOINT=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=
S3_FORCE_PATH_STYLE=

# Meeting playback, final transcription and cleanup use the same Recording R2
# configuration as the web/backend runtime, not the resume-upload S3 bucket.
# Supply all seven values to the deployed worker. Blank values override image defaults.
RECORDING_R2_ENDPOINT=
RECORDING_R2_BUCKET_NAME=
RECORDING_R2_REGION=auto
RECORDING_R2_ACCESS_KEY_ID=
RECORDING_R2_SECRET_ACCESS_KEY=
RECORDING_R2_KEY_PREFIX=recordings
RECORDING_R2_FORCE_PATH_STYLE=true
