# =====================================================================
# Desktop renderer (Vite) — only VITE_* are exposed to the UI process
# =====================================================================

# Better Auth API origin (same as web NEXT_PUBLIC_BETTER_AUTH_URL / BETTER_AUTH_URL).
# Desktop is client-only; OAuth still hits this server for Feishu callbacks.
# Renderer CSP allows connect-src to https: and localhost (see index.html).
VITE_BETTER_AUTH_URL=http://localhost:3000

# Electron main + renderer project DSN. SENTRY_DSN is an optional one-project fallback.
SENTRY_DESKTOP_DSN=
SENTRY_DSN=

# Recording R2 S3 API origin. Main process only uploads Saved Meeting audio
# to this origin (or its bucket subdomain), never to an origin supplied by renderer code.
# Example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
VITE_RECORDING_R2_UPLOAD_ORIGIN=

# 如果用线上的话，可以用这个
# VITE_BETTER_AUTH_URL=https://interview.chainthink.cn


# Public app origin used when building absolute callback URLs.
# Dev: electron-vite renderer origin (default often http://localhost:5173).
# Must be listed in backend better-auth trustedOrigins.
VITE_BASE_URL=http://localhost:5173
