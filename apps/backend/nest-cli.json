{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": {
      "type": "rspack",
      "options": {
        "configPath": "rspack.config.cjs"
      }
    },
    "deleteOutDir": true,
    "assets": [
      {
        "include": "**/*.{html,json,md,prompt,wasm}",
        "outDir": "dist"
      }
    ]
  }
}
