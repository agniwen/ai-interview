# =====================================================================
# LiveKit Server / Cloud — agent worker 接入凭据
# LiveKit Server / Cloud — credentials the agent worker uses to join
# =====================================================================
# 由 livekit-agents SDK 隐式读取（worker 启动时连接 LiveKit Server / Cloud）。
# 三个值与 web 端 .env 中的同名变量必须一致。
# Implicitly read by the livekit-agents SDK when the worker connects.
# Must match the same-named values in the web app's root .env.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match AGENT_NAME / NEXT_PUBLIC_AGENT_NAME on the web side.
AGENT_NAME=giaogiao

# Set to 1 only for a self-hosted LiveKit server + self-hosted agent deployment.
# This pins the local v1-mini turn detector, uses VAD interruption handling,
# and disables LiveKit Cloud-only noise cancellation. Leave unset for LiveKit Cloud.
# INTERVIEW_SELF_HOSTED=1

# Manual noise-cancellation override for local troubleshooting. Self-hosted mode
# disables Cloud-only noise cancellation automatically.
# INTERVIEW_DISABLE_NOISE_CANCELLATION=1

# =====================================================================
# LLM —— 阿里云 DashScope（OpenAI 兼容端点）
# LLM — Aliyun DashScope (OpenAI-compatible endpoint)
# =====================================================================
# DashScope API key，agent.py 通过 openai.LLM(api_key=...) 显式注入。
# DashScope API key — injected into agent.py via openai.LLM(api_key=...).
DASHSCOPE_API_KEY=

# 可选，覆盖 agent 用的对话模型 id；默认 deepseek-v4-flash。
# Optional override for the agent's chat model id; defaults to deepseek-v4-flash.
DASHSCOPE_LLM_MODEL=

# =====================================================================
# STT —— ElevenLabs Scribe v2 批量识别（livekit-plugins-elevenlabs 隐式读取）
# STT — ElevenLabs Scribe v2 batch recognition (implicitly read by livekit-plugins-elevenlabs)
# =====================================================================
# 注意 plugin 用的环境变量名是 ELEVEN_API_KEY（不是 ELEVENLABS_API_KEY）。
# Note the plugin reads ELEVEN_API_KEY (not ELEVENLABS_API_KEY).
ELEVEN_API_KEY=

# =====================================================================
# Deepgram —— 保留备用
# Deepgram — kept for fallback/experiments
# =====================================================================
DEEPGRAM_API_KEY=

# =====================================================================
# TTS —— Minimax（livekit-plugins-minimax-ai 隐式读取）
# TTS — Minimax (implicitly read by livekit-plugins-minimax-ai)
# =====================================================================
MINIMAX_API_KEY=

# =====================================================================
# Agent → web 回调
# Agent → web callbacks
# =====================================================================
# Web 服务的公网基础地址，agent 通过 `${CALLBACK_BASE_URL}/api/agent/...` 上报事件。
# Base URL of the web service; the agent posts events to `${CALLBACK_BASE_URL}/api/agent/...`.
CALLBACK_BASE_URL=

# 与 web 端共享的回调密钥，用于 HMAC / bearer 校验，防伪造。两端必须一致。
# Shared callback secret used for HMAC / bearer verification; must match the web side.
AGENT_CALLBACK_SECRET=

# =====================================================================
# Cloudflare R2 —— LiveKit Egress 录制存储
# Cloudflare R2 — LiveKit Egress recording storage
# =====================================================================
# 面试录制走 LiveKit Egress 直推 R2，需要在 agent 进程里读取以下凭据。
# 与 web 端 .env 中的同名变量保持一致。
# Interview recordings are pushed straight from LiveKit Egress to R2;
# the agent process reads these credentials. Keep in sync with the web app's root .env.
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
RECORDING_R2_ENDPOINT=
RECORDING_R2_BUCKET_NAME=
RECORDING_R2_ACCESS_KEY_ID=
RECORDING_R2_SECRET_ACCESS_KEY=
RECORDING_R2_REGION=auto
RECORDING_R2_FORCE_PATH_STYLE=true
