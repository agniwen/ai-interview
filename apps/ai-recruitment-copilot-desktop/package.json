{
  "name": "@arc/ai-recruitment-copilot-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Meeting Buddy (AI Recruitment Copilot Desktop) — Electron app for HR–candidate conversation capture and transcription",
  "homepage": "https://github.com/agniwen/ai-interview",
  "author": "ARC",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "db:generate": "drizzle-kit generate --config drizzle.local.config.ts",
    "build": "bun run typecheck && electron-vite build",
    "build:unpack": "bun run build && electron-builder --dir --config.mac.icon=icon.icns",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:mac:legacy": "electron-vite build && electron-builder --mac --config.mac.icon=icon.icns",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@arc/db-schema": "workspace:*",
    "@arc/shared": "workspace:*",
    "@base-ui/react": "^1.5.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@hookform/resolvers": "^5.4.0",
    "@iconify-json/ph": "^1.2.2",
    "@iconify/react": "^6.0.2",
    "@livekit/components-react": "^2.9.21",
    "@orpc/client": "2.0.0-beta.25",
    "@orpc/contract": "2.0.0-beta.25",
    "@orpc/server": "2.0.0-beta.25",
    "@outpacelabs/avatars": "^0.4.1",
    "@sentry/electron": "7.17.0",
    "@tanstack/charts": "0.6.4",
    "@tanstack/query-core": "^5.100.14",
    "@tanstack/react-charts": "0.6.4",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-virtual": "^3.14.2",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "date-fns": "4.4.0",
    "dayjs": "^1.11.20",
    "drizzle-orm": "catalog:",
    "glimm": "0.3.0",
    "jotai": "^2.20.2",
    "livekit-client": "^2.20.1",
    "misans": "4.1.0",
    "motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "radix-ui": "1.6.1",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.76.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "write-file-atomic": "^7.0.1",
    "ws": "^8.21.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "24.11.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/write-file-atomic": "^4.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "catalog:",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "4.13.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
