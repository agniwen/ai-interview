# =====================================================================
# Core database / app URLs
# =====================================================================

# Postgres connection string shared by Drizzle ORM and Better Auth.
DATABASE_URL=

# Redis connection string for queues/cache. For password-only Redis:
# redis://:password@host:6379/0
REDIS_URL=redis://:password@host:6379/0

# Meeting playback worker. Docker installs ffmpeg; set FFMPEG_BIN only for a custom path.
# Override only when producer and worker intentionally share a deployment namespace.
# MEETING_PLAYBACK_QUEUE_PREFIX=
MEETING_PLAYBACK_WORKER_CONCURRENCY=2
# Final Meeting Transcript provider policy and queue producer.
# MEETING_TRANSCRIPTION_QUEUE_PREFIX=
MEETING_TRANSCRIPTION_OPENAI_ENABLED=false
MEETING_TRANSCRIPTION_OPENAI_MODEL=gpt-4o-transcribe-diarize
MEETING_TRANSCRIPTION_OPENAI_LIVE_MODEL=gpt-4o-mini-transcribe
MEETING_TRANSCRIPTION_OPENAI_REGION=openai-default
FFMPEG_BIN=ffmpeg

# Workflow target must be explicit; it does not fall back to DATABASE_URL.
WORKFLOW_TARGET_WORLD=

# Public application URLs. Keep BETTER_AUTH_URL and NEXT_PUBLIC_BASE_URL in sync.
BETTER_AUTH_URL=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_PUBLIC_URL=

# Browser-side Better Auth API origin. Keep it explicit; no runtime fallback.
NEXT_PUBLIC_BETTER_AUTH_URL=

# Optional extra trusted origins for better-auth (comma-separated).
# Code already defaults to local web + desktop origins; only set this to *add*
# more (e.g. staging URLs). Empty/unset keeps the built-in defaults.
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
BETTER_AUTH_TRUSTED_ORIGINS=

# Postgres.js pool and connection lifetime settings.
POSTGRES_POOL_MAX=
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_IDLE_TIMEOUT_SECONDS=60
POSTGRES_MAX_LIFETIME_SECONDS=1200

# =====================================================================
# Core secrets
# =====================================================================

# Generate a fresh production value, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Optional platform admin organization id.
ADMIN_ORGANIZATION_ID=

# =====================================================================
# Google OAuth / Google AI
# =====================================================================

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Explicit boolean string. Use true to show Google login and hide Feishu login.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# AI interview candidate-specific question generation. Defaults to true when unset.
NEXT_PUBLIC_ENABLE_CANDIDATE_SPECIFIC_INTERVIEW_QUESTIONS=true

# Global user watermark overlay. Defaults to true when unset.
NEXT_PUBLIC_ENABLE_WATERMARK=true

# Developer-only AI interview session overview and call metrics. Defaults to false.
NEXT_PUBLIC_ENABLE_INTERVIEW_DEVELOPER_DETAILS=false

# Development-only: force the new-version notice for local UI testing. Defaults to false.
NEXT_PUBLIC_FORCE_APP_UPDATE_NOTICE=false

# Google AI provider key, if enabled by the deployment.
GOOGLE_GENERATIVE_AI_API_KEY=

# =====================================================================
# Alibaba DashScope / Qwen
# =====================================================================

# DashScope OpenAI-compatible endpoint and key.
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=

# Alibaba OpenAI-compatible model ids. Business code does not hard-code fallbacks.
ALIBABA_MODEL=deepseek-v4-flash-0731
ALIBABA_FAST_MODEL=deepseek-v4-flash-0731
ALIBABA_STRUCTURED_MODEL=deepseek-v4-flash-0731
ALIBABA_VISION_MODEL=

# Qwen-VL OCR endpoint and model id.
QWEN_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_OCR_MODEL=qwen-vl-ocr-latest

# Resume parser implementation. Defaults to ocr-llm when unset.
# Supported values: ocr-llm, aliyun-docmining.
RESUME_PARSE_PROVIDER=ocr-llm

# =====================================================================
# Vercel AI Gateway
# =====================================================================

# Read implicitly by AI SDK gateway() for interview evaluation.
AI_GATEWAY_API_KEY=
INTERVIEW_EVALUATION_MODEL=google/gemini-2.5-flash

# =====================================================================
# Zhipu
# =====================================================================

ZHIPU_API_KEY=
ZHIPU_MODEL=

# =====================================================================
# LiveKit / agent callback
# =====================================================================

# LiveKit Cloud or self-hosted URL and credentials. LIVEKIT_URL accepts ws(s) or http(s).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional server-only Prometheus scrape endpoint for Platform > LiveKit metrics.
# Example: http://livekit-host.internal:6789/metrics
LIVEKIT_PROMETHEUS_URL=

# Must match the agent_name registered by the Python worker.
AGENT_NAME=giaogiao
NEXT_PUBLIC_AGENT_NAME=giaogiao

# Web service public base URL for agent callbacks.
CALLBACK_BASE_URL=

# Shared secret for agent -> web callbacks. Both sides must match.
AGENT_CALLBACK_SECRET=

# =====================================================================
# ElevenLabs
# =====================================================================

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# =====================================================================
# MiniMax
# =====================================================================

MINIMAX_TTS_BASE_URL=https://api.minimax.chat
MINIMAX_API_KEY=

# =====================================================================
# Feishu
# =====================================================================

# Primary Feishu app credentials.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_EVALUATION_FOLDER_TOKEN=

# Optional secondary Feishu app credentials.
FEISHU_APP_ID2=
FEISHU_APP_SECRET2=
FEISHU_JIGUANG_HR_EVALUATION_FOLDER_TOKEN=

# Set true only in the long-running backend process that should maintain
# official Chat SDK Lark/Feishu websocket bot connections.
FEISHU_BOT_ENABLED=false

# =====================================================================
# S3-compatible storage
# =====================================================================

# Leave S3_ENDPOINT blank for AWS S3; set it for S3-compatible providers.
S3_ENDPOINT=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=uploads
S3_FORCE_PATH_STYLE=false

# =====================================================================
# Recording R2 storage
# =====================================================================

# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
RECORDING_R2_ENDPOINT=
RECORDING_R2_BUCKET_NAME=
RECORDING_R2_REGION=auto
RECORDING_R2_ACCESS_KEY_ID=
RECORDING_R2_SECRET_ACCESS_KEY=
RECORDING_R2_KEY_PREFIX=recordings
RECORDING_R2_FORCE_PATH_STYLE=true

# AI interview recording feature flag. Defaults to true when unset.
NEXT_PUBLIC_ENABLE_INTERVIEW_RECORDING=true

# =====================================================================
# Resume parse queue
# =====================================================================

RESUME_PARSE_QUEUE_ATTEMPTS=3
RESUME_PARSE_QUEUE_BACKOFF_MS=30000
RESUME_PARSE_STALE_PROCESSING_SECONDS=900
RESUME_PARSE_OCR_PAGE_CONCURRENCY=4
RESUME_PARSE_OCR_ATTEMPTS=3
RESUME_PARSE_OCR_RETRY_DELAY_MS=1000
RESUME_PARSE_DISABLE_CACHE=false

# =====================================================================
# Resend email
# =====================================================================

# Use a bare email address. The display name is built dynamically at runtime.
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com

# =====================================================================
# PostHog
# =====================================================================

NEXT_PUBLIC_ENABLE_POSTHOG=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
POSTHOG_API_HOST=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
