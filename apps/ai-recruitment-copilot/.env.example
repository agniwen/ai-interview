# =====================================================================
# Database
# =====================================================================

# Postgres 连接串，Drizzle ORM 和 Better Auth 共用。
# Postgres connection string — shared by Drizzle ORM and Better Auth.
DATABASE_URL=

# =====================================================================
# Better Auth
# =====================================================================

# Better Auth 用来签名 / 加密 session、CSRF token 等的随机密钥；
# 生产环境必须独立设置（建议 `openssl rand -base64 32`），切勿提交到仓库。
# Random secret Better Auth uses to sign/encrypt sessions, CSRF tokens, etc.
# Generate a fresh value in production (e.g. `openssl rand -base64 32`); never commit.
BETTER_AUTH_SECRET=

# 生产环境必须设为真实域名（不带尾斜杠），如 https://app.example.com。
# Google Cloud Console「已获授权的重定向 URI」需要登记
# `${BETTER_AUTH_URL}/api/auth/callback/google`，否则会触发 redirect_uri_mismatch。
# Production must be the real domain (no trailing slash), e.g. https://app.example.com.
# Register `${BETTER_AUTH_URL}/api/auth/callback/google` in Google Cloud Console
# under "Authorised redirect URIs" — mismatch causes redirect_uri_mismatch.
BETTER_AUTH_URL=

# 浏览器侧拼绝对 callbackURL 用，跟 BETTER_AUTH_URL 保持一致。
# Used in the browser to build an absolute callbackURL; keep in sync with BETTER_AUTH_URL.
NEXT_PUBLIC_BASE_URL=

# 可选：浏览器侧 Better Auth API origin。留空时使用当前站点 origin；
# 当前端和 Hono 后端分域/分端口部署时，填 Hono 后端公开地址，如 http://localhost:8787。
# Optional browser-side Better Auth API origin. Empty means current site origin;
# set it when the frontend and Hono backend are on different domains/ports.
VITE_BETTER_AUTH_URL=

# Google OAuth 凭据（来自 Google Cloud Console -> Credentials -> OAuth 2.0 Client）。
# Google OAuth credentials (Google Cloud Console -> Credentials -> OAuth 2.0 Client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 登录入口开关：设置任意非空值后，登录页会显示 Google 登录并隐藏飞书登录；
# 留空则保持默认（飞书登录）。生产国内 IDC 无法连通 oauth2.googleapis.com，
# 应当留空；本地 dev 或有海外出口的部署可设为 `1` 开启。Vite 已配置
# envPrefix 暴露 NEXT_PUBLIC_*，客户端通过 import.meta.env 读取。
# Login entry toggle: set to any non-empty value to show Google sign-in and
# hide Feishu on the login page; leave blank for the default (Feishu).
# Production runs from a domestic IDC that can't reach oauth2.googleapis.com,
# so keep it blank there; local dev or overseas-egress deployments can set it
# to `1`. Vite is configured with envPrefix for NEXT_PUBLIC_*, and client code
# reads these values from import.meta.env.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=

# =====================================================================
# 主 LLM 提供方：阿里云 DashScope（Qwen 系列 + DeepSeek 兼容模式）
# Primary LLM provider: Aliyun DashScope (Qwen + DeepSeek compat endpoint)
# =====================================================================

# DashScope API key，用于简历筛选 chat / 标题生成 / Qwen-VL OCR / JD ranker。
# DashScope API key — powers screening chat, title generation, Qwen-VL OCR, JD ranker.
ALIBABA_API_KEY=

# DashScope base URL。留空走默认值 https://dashscope.aliyuncs.com/compatible-mode/v1，
# 私有部署或代理时填入对应地址。
# DashScope base URL. Leave blank to use the default
# https://dashscope.aliyuncs.com/compatible-mode/v1; override for private / proxied deploys.
ALIBABA_BASE_URL=

# =====================================================================
# Voice agent / 语音相关
# =====================================================================

# ElevenLabs API key，被 LiveKit Python agent 通过 livekit-plugins-elevenlabs 隐式读取
# （TTS / STT）。在 web 侧的 .env 里写一份，agent 启动时也能拿到。
# ElevenLabs API key — implicitly read by the LiveKit Python agent
# (livekit-plugins-elevenlabs) for TTS / STT. Defined here so the agent picks it up too.
ELEVENLABS_API_KEY=

# MiniMax API key。Python agent 用它做正式面试 TTS；web 后端也用它为面试官音色生成
# 公共试听音频（首次试听生成并上传，后续复用缓存）。
# MiniMax API key. The Python agent uses it for interview TTS; the web server
# also uses it to generate public interviewer-voice preview audio on cache miss.
MINIMAX_API_KEY=

# 可选。MiniMax TTS HTTP base URL，留空默认 https://api.minimax.chat。
# Optional. MiniMax TTS HTTP base URL. Defaults to https://api.minimax.chat.
MINIMAX_TTS_BASE_URL=

# =====================================================================
# Vercel AI Gateway
# =====================================================================

# Vercel AI Gateway key（用于面试结束后的评估，模型走 google/gemini-2.5-flash 等）。
# 由 `ai` SDK 的 gateway provider 隐式读取，无需手动 import。
# Vercel AI Gateway key — used for post-interview evaluation
# (default model google/gemini-2.5-flash). Read implicitly by the `ai` SDK gateway provider.
AI_GATEWAY_API_KEY=

# =====================================================================
# LiveKit Cloud — 语音 agent 运行时
# LiveKit Cloud — voice agent runtime
# =====================================================================

# LiveKit Cloud 项目地址 / API 凭据。LIVEKIT_URL 为 wss:// 形式。
# LiveKit Cloud project URL / API credentials. LIVEKIT_URL is a wss:// endpoint.
# LIVEKIT_URL=wss://ai-interview-livekit.guadd.fun
# LIVEKIT_API_KEY=livekit
# LIVEKIT_API_SECRET=ai-interview
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 必须与 Python worker 注册的 agent_name 一致（见 agent/src/agent.py）。
# 服务端用它在 dispatch interview 时定向唤起对应 worker。
# Must match the agent_name registered by the Python worker (agent/src/agent.py).
# Used server-side to dispatch interview sessions to the correct worker.
AGENT_NAME=

# 浏览器侧 AgentDispatch 也需要知道 agent_name，因此暴露一份 NEXT_PUBLIC_ 版本，
# 保持与 AGENT_NAME 同步。
# Browser-side AgentDispatch also needs the agent_name; expose a NEXT_PUBLIC_ mirror
# kept in lock-step with AGENT_NAME.
NEXT_PUBLIC_AGENT_NAME=


# Agent → web 回调的共享密钥，web 端 `/api/agent/*` 路由用它做 HMAC / bearer 校验，
# 防止任何第三方伪造面试事件。两端值必须一致。
# Shared secret for agent → web callbacks. The web `/api/agent/*` routes validate it
# (HMAC / bearer) to reject forged interview events. Both sides must match.
AGENT_CALLBACK_SECRET=

# =====================================================================
# PostHog（产品埋点，可选）
# PostHog (optional product analytics)
# =====================================================================

# 设为 true 后启用 PostHog 客户端埋点。默认关闭，避免本地开发误上报。
# Set to true to enable PostHog client-side analytics. Disabled by default
# to avoid accidental local event capture.
NEXT_PUBLIC_ENABLE_POSTHOG=false

# PostHog Project token（通常以 phc_ 开头）。这是公开 token，可暴露给浏览器。
# PostHog project token (usually starts with phc_). This is a public token
# and is safe to expose to the browser.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# PostHog ingest host。US Cloud 默认 https://us.i.posthog.com；
# EU Cloud 按 PostHog 项目设置填写对应地址。
# PostHog ingest host. US Cloud default is https://us.i.posthog.com;
# use the EU host if the project is hosted in PostHog EU.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Platform 埋点 dashboard 服务端查询 PostHog 用。PERSONAL_API_KEY 只能放服务端，
# 不要加 NEXT_PUBLIC_ 前缀。API host 是 PostHog app/API host，不是 ingest host；
# US Cloud 通常为 https://us.posthog.com，EU Cloud 按项目区域填写。
# Server-side PostHog query config for the platform analytics dashboard.
# PERSONAL_API_KEY must stay on the server (no NEXT_PUBLIC_ prefix). API host is
# the PostHog app/API host, not the ingest host; US Cloud is usually
# https://us.posthog.com, EU Cloud depends on the project region.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com

# =====================================================================
# Feishu 集成（可选，用于飞书机器人 / 多租户）
# Feishu integration (optional — Feishu bot / multi-tenant)
# =====================================================================

# Feishu 应用凭据（来自飞书开放平台 -> 应用 -> 凭证与基础信息）。
# 支持配置两个独立应用：默认应用走 *_APP_ID / *_APP_SECRET，副应用走带 2 的变量。
# Feishu app credentials (Feishu Open Platform -> App -> Credentials).
# Two independent apps are supported: primary uses *_APP_ID / *_APP_SECRET,
# secondary uses the variables suffixed with 2.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_ID2=
FEISHU_APP_SECRET2=

# 飞书事件订阅的加密 key 与校验 token，用于解密 / 校验回调消息。
# Encryption key + verification token for Feishu event subscriptions
# (decrypt / verify incoming callbacks).
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# =====================================================================
# S3-compatible object storage（简历 PDF、附件上传）
# S3-compatible object storage (resume PDFs, general attachments)
# =====================================================================

# S3 / 兼容服务端点。如使用 AWS S3 可留空（SDK 默认走 AWS）。
# S3 / S3-compatible endpoint. Leave blank for AWS S3 (SDK default).
S3_ENDPOINT=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 对象 key 前缀，便于把上传和录制隔离到不同子目录（可留空）。
# Optional key prefix used to namespace uploaded objects (may be empty).
S3_KEY_PREFIX=

# 是否强制 path-style 访问（MinIO / 部分私有 S3 必须为 true）。
# Force path-style addressing (required by MinIO / some self-hosted S3). Default false.
S3_FORCE_PATH_STYLE=

# =====================================================================
# Redis / resume parse queue（批量简历异步解析）
# Redis / resume parse queue (async bulk resume parsing)
# =====================================================================

# Redis 连接串。无用户名但有密码时写作 redis://:password@host:6379/0
# Redis connection string. For password-only Redis, use redis://:password@host:6379/0
REDIS_URL=redis://:de893df257e31c51873583cb292a8b24@10.210.16.3:6379/2

# 批量简历解析任务重试次数与指数退避基准时间。
# Queue retry attempts and exponential-backoff base delay for bulk resume parsing.
RESUME_PARSE_QUEUE_ATTEMPTS=3
RESUME_PARSE_QUEUE_BACKOFF_MS=30000

# processing 状态超过该秒数才视为 worker 中断残留，避免长 OCR/评价被误判。
# Processing items older than this are treated as interrupted worker leftovers.
RESUME_PARSE_STALE_PROCESSING_SECONDS=900

# 单份 PDF 内 OCR 页级并发与连接类瞬断重试配置。
# Per-PDF OCR page concurrency and transient connection retry settings.
RESUME_PARSE_OCR_PAGE_CONCURRENCY=1
RESUME_PARSE_OCR_ATTEMPTS=3
RESUME_PARSE_OCR_RETRY_DELAY_MS=1000

# 测试真实解析链路时可设为 true：即使命中同 hash 的已解析缓存，也强制重新从 S3 读取并解析。
# Set to true when benchmarking the real parse path: bypasses same-hash parsed cache.
RESUME_PARSE_DISABLE_CACHE=false

# =====================================================================
# Cloudflare R2 — LiveKit Egress 面试录制存储
# Cloudflare R2 — LiveKit Egress interview recording storage
# =====================================================================
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
RECORDING_R2_ENDPOINT=
RECORDING_R2_BUCKET_NAME=
RECORDING_R2_REGION=auto
RECORDING_R2_ACCESS_KEY_ID=
RECORDING_R2_SECRET_ACCESS_KEY=
RECORDING_R2_KEY_PREFIX=
RECORDING_R2_FORCE_PATH_STYLE=true

# =====================================================================
# 模型覆盖（可选，均带默认值）
# Model overrides (optional, all have sensible defaults)
# =====================================================================

# 可选,带默认值。覆盖面试结果评估用的模型(走 Vercel AI gateway),默认 google/gemini-2.5-flash。
# Optional, has a default. Overrides the interview-evaluation model
# (via Vercel AI gateway). Defaults to google/gemini-2.5-flash.
INTERVIEW_EVALUATION_MODEL=

# 可选,带默认值。覆盖 Qwen-VL OCR 模型 ID,默认 qwen-vl-ocr-latest。
# Optional, has a default. Overrides the Qwen-VL OCR model id. Defaults to
# qwen-vl-ocr-latest.
QWEN_OCR_MODEL=

# =====================================================================
# Resend (transactional email)
# =====================================================================

# 中文：发件人地址。只写裸邮箱地址（不要加 "Display <...>"），
# 域名必须在 Resend 控制台已验证，否则会被拒绝。
# 邮件 From 头里的显示名会在运行时由代码动态拼接：
# 「{系统设置里的公司名} AI HR」<addr>，没填公司名退化为「AI HR」<addr>。
# 写成 "Name <addr>" 也能跑（代码会自动剥掉显示名），但部署脚本里出现
# `<...>` 会被 shell 当成 stdin 重定向，所以推荐裸地址。
# English: From address. Use a bare email address (no "Display <...>"). The
# domain MUST be verified in the Resend dashboard. The actual From-header
# display name is built at runtime as "{globalConfig.companyName} AI HR"
# (or "AI HR" when blank). "Name <addr>" works too — the code strips the
# display part — but bare avoids shell-redirection breakage in deploy scripts.
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com
