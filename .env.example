# Vercel AI Gateway
AI_GATEWAY_API_KEY=your-ai-gateway-api-key
ALIBABA_API_KEY=your-alibaba-api-key
ALIBABA_MODEL=deepseek-v4-pro
ALIBABA_STRUCTURED_MODEL=deepseek-v4-flash
ALIBABA_FAST_MODEL=deepseek-v4-flash
# Optional: custom endpoint / proxy
# ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OCR model for image-based PDF resumes (Qwen-VL OCR via DashScope)
QWEN_OCR_MODEL=qwen-vl-ocr-latest
QWEN_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
QWEN_KEY=

# LiveKit Cloud — voice agent runtime
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the agent_name registered by the Python worker (agent/src/agent.py)
AGENT_NAME=my-agent
NEXT_PUBLIC_AGENT_NAME=my-agent

NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false


# Feishu (飞书) — shared between the bot adapter and OAuth sign-in.
# For OAuth login, enable "网页应用" capability on the Feishu developer console
# and add ${BETTER_AUTH_URL}/api/auth/oauth2/callback/feishu as a redirect URL.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Required for event subscription decryption + signature verification.
# Configure these in the Feishu Developer Console under "Event Subscription".
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_APP_ID2=
FEISHU_APP_SECRET2=
S3_ENDPOINT=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Prefix for all object keys; set to "dev" for local, "prod" for production so
# dev/prod can safely share the same bucket.
S3_KEY_PREFIX=dev
# Set to "true" only for path-style backends like MinIO. Tencent COS / Cloudflare R2 / AWS S3
# must use virtual-hosted style (default false), otherwise LiveKit Egress upload will fail.
S3_FORCE_PATH_STYLE=false
