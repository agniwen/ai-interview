DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALIBABA_API_KEY=
ALIBABA_BASE_URL=
ELEVENLABS_API_KEY=
AI_GATEWAY_API_KEY=

# LiveKit Cloud — voice agent runtime
# LIVEKIT_URL=wss://ai-interview-livekit.guadd.fun
# LIVEKIT_API_KEY=livekit
# LIVEKIT_API_SECRET=ai-interview
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the agent_name registered by the Python worker (agent/src/agent.py)
AGENT_NAME=
NEXT_PUBLIC_AGENT_NAME=
CALLBACK_BASE_URL=
AGENT_CALLBACK_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_ID2=
FEISHU_APP_SECRET2=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

S3_ENDPOINT=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=
S3_FORCE_PATH_STYLE=

# Cloudflare R2 - LiveKit Egress interview recording storage
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
RECORDING_R2_ENDPOINT=
RECORDING_R2_BUCKET_NAME=
RECORDING_R2_REGION=auto
RECORDING_R2_ACCESS_KEY_ID=
RECORDING_R2_SECRET_ACCESS_KEY=
RECORDING_R2_KEY_PREFIX=
RECORDING_R2_FORCE_PATH_STYLE=true

# 可选,带默认值。覆盖面试结果评估用的模型(走 Vercel AI gateway),默认 google/gemini-2.5-flash。
# Optional, has a default. Overrides the interview-evaluation model
# (via Vercel AI gateway). Defaults to google/gemini-2.5-flash.
INTERVIEW_EVALUATION_MODEL=
# 可选,带默认值。覆盖 Qwen-VL OCR 模型 ID,默认 qwen-vl-ocr-latest。
# Optional, has a default. Overrides the Qwen-VL OCR model id. Defaults to
# qwen-vl-ocr-latest.
QWEN_OCR_MODEL=
