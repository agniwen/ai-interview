# Copy to .env. This file is only for local media infrastructure, not app secrets.
# Set the current Mac LAN IPv4 address (for example: ipconfig getifaddr en0).
LIVEKIT_LOCAL_IP=192.168.1.100
LIVEKIT_LOCAL_API_KEY=localdev
# Replace with a random secret of at least 32 characters; do not use production keys.
LIVEKIT_LOCAL_API_SECRET=
